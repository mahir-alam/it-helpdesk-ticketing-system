# ─── Database (Supabase hosted Postgres) ───────────────────────────────
# Pooled connection (pgbouncer) — used by the app at runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# Direct connection — used by Prisma for migrations
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ─── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# ─── Server ───────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── Alerting ─────────────────────────────────────────────────────────
# Discord webhook fired when a P1 ticket is created / breaches SLA.
# Leave blank to make the alert path a logged no-op.
DISCORD_WEBHOOK_URL=

# Shared secret required by POST /api/tickets/auto-create (external integrations).
# Leave blank to leave the endpoint open (dev only).
INTEGRATION_API_KEY=

# ─── Background jobs ──────────────────────────────────────────────────
ENABLE_CRON=true
PROBLEM_DETECTION_THRESHOLD=3
PROBLEM_DETECTION_WINDOW_MINUTES=120

# ─── Seed admin (created by prisma/seed.js) ───────────────────────────
SEED_ADMIN_EMAIL=admin@helpdesk.local
SEED_ADMIN_PASSWORD=Admin!2345
SEED_DEFAULT_PASSWORD=Passw0rd!
